# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Empty DATABASE_URL: in-memory repositories (no database needed to try the HTTP contract).
DATABASE_URL=jdbc:postgresql://localhost:5432/barbersaas
DATABASE_USER=platform_admin_app
DATABASE_PASSWORD=
# SPKI PEM public key, one line with \n escapes. barber-saas-infra-postgres/scripts/dev-keys.sh generates a development one.
JWT_PUBLIC_KEY=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# barbershop-api's internal operations (DEC-SHOP-06). Empty: the barbershop screens answer 503.
BARBERSHOP_API_URL=http://localhost:8082
# identity-auth's owners read (DEC-AUTH-10), for the plan notices.
IDENTITY_AUTH_API_URL=http://localhost:8081
# This service's own token (sub: barber-saas-platform-admin-api), PLATFORM_ADMIN_SERVICE_TOKEN in barber-saas-infra-postgres/env/dev.env.
SERVICE_TOKEN=
# Without Wompi keys: true opens the simulated checkout (DEC-PLAT-08); empty or false, no payment starts.
PAYMENTS_SIMULATOR=
# Wompi in sandbox (ADR-017): pub_test_ key and the test secrets of the team's account, never real ones.
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=
